# SoilChain Environment Variables Template
# Copy this to a .env file and fill in your real credentials

# Sentinel Hub API (for Real NDVI Data)
SENTINEL_HUB_CLIENT_ID=your_client_id_here
SENTINEL_HUB_CLIENT_SECRET=your_client_secret_here

# Blockchain Integration (Polygon Amoy)
BLOCKCHAIN_PRIVATE_KEY=your_private_key_here
POLYGON_AMOY_RPC=https://rpc-amoy.polygon.technology
SOILTOKEN_CONTRACT_ADDRESS=0x...
